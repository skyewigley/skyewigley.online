# Copy to .env.local for local development:  cp .env.example .env.local
# In production, set the same keys in Coolify (tick "Build Variable").
#
# These are PUBLIC values: the site is static, so they end up in the HTML.
# Never put secrets here.

# Full public URL, no trailing slash (used for canonical URL, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the navbar, page title, about section and footer
NEXT_PUBLIC_NAME=Your Name
# Optional: badge letters in the navbar (defaults to initials of NEXT_PUBLIC_NAME)
NEXT_PUBLIC_INITIALS=

# Contact section and /contact page (each item is hidden if left empty)
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_BOOKING_URL=
# Usernames, shown with a copy button, e.g. @yourname
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_DISCORD=
# The /contact form POSTs JSON { name, email, message } here (e.g. an n8n webhook).
# Public: validate the payload in the workflow.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# YouTube video ID for the intro video, e.g. the part after v= in a YouTube URL
NEXT_PUBLIC_INTRO_VIDEO_ID=

# Footer and /contact socials (each hidden if left empty)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_UPWORK_URL=
